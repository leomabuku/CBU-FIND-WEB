{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cbu-find-web",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },
  "observability": {
    "enabled": true
  }
}
